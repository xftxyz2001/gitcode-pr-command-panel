{
  "manifest_version": 3,
  "name": "GitCode PR 快捷命令",
  "version": "1.2.0",
  "description": "在 GitCode Pull Request 页面显示常用机器人评论命令，并通过 GitCode 评论接口一键发送。",
  "content_scripts": [
    {
      "matches": [
        "https://gitcode.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gitcode.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
